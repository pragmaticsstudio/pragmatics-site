---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/clean/Hero.astro";

const page = (await getCollection("pages")).find((entry) => entry.data.route === "");
if (!page) throw new Error("Homepage content is missing");
const { Content } = await render(page);
const { data } = page;
---

<Base title={page.data.title} description={page.data.description}>
	{data.clean ? (
		<div class="clean-page">
			<div class="clean-container">
				{data.hero && <Hero {...data.hero} />}
				<div class="clean-prose">
					<Content />
				</div>
			</div>
		</div>
	) : (
		<Content />
	)}
</Base>
