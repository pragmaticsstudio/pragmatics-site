---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/clean/Hero.astro";
import { addImageSizes } from "../lib/image-size.mjs";

const page = (await getCollection("pages")).find((entry) => entry.data.route === "");
if (!page) throw new Error("Homepage content is missing");
const { Content } = await render(page);
const html = addImageSizes(page.rendered?.html ?? "");
const { data } = page;
---

<Base title={page.data.title} description={page.data.description}>
	{data.clean ? (
		<div class="clean-page">
			<div class="clean-container">
				{data.hero && data.heroVideo ? (
					<div class="clean-hero-split">
						<Hero {...data.hero} />
						<video class="clean-hero-video" autoplay muted loop playsinline preload="metadata" poster={`${data.heroVideo}-poster.jpg`} width="720" height="720">
							<source src={`${data.heroVideo}.mp4`} type="video/mp4" />
							<source src={`${data.heroVideo}.webm`} type="video/webm" />
						</video>
					</div>
				) : (
					data.hero && <Hero {...data.hero} />
				)}
				<div class="clean-prose">
					<Fragment set:html={html} />
				</div>
			</div>
		</div>
	) : (
		<Content />
	)}
</Base>
