---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/clean/Hero.astro";
import MetaList from "../../components/clean/MetaList.astro";
import { imageSize, addImageSizes } from "../../lib/image-size.mjs";

export async function getStaticPaths() {
	const entries = await getCollection("posts");
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const html = addImageSizes(entry.rendered?.html ?? "");
---

<Base title={data.title} description={data.description}>
	<div class="clean-page">
		<div class="clean-container">
			<div class="clean-prose">
				<p><a href="/blog/">← All writing</a></p>
			</div>
			<Hero heading={data.title} subheading={data.description} />
			{data.author && <MetaList items={[{ label: "Author", value: data.author }]} />}
			{data.image && <img class="clean-cover" src={data.image} alt={data.imageAlt ?? ""} {...imageSize(data.image)} />}
			<div class="clean-section clean-prose clean-story">
				<Fragment set:html={html} />
			</div>
		</div>
	</div>
</Base>
