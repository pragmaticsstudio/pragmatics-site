---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/clean/Hero.astro";
import { addImageSizes } from "../lib/image-size.mjs";

export async function getStaticPaths() {
	const pages = await getCollection("pages");
	return pages
		.filter((entry) => entry.data.route !== "")
		.map((entry) => ({ params: { slug: entry.data.route }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const html = addImageSizes(entry.rendered?.html ?? "");
const { data } = entry;
---

<Base title={entry.data.title} description={entry.data.description}>
	{data.clean ? (
		<div class="clean-page">
			<div class="clean-container">
				{data.hero && <Hero {...data.hero} />}
				<div class="clean-prose">
					<Fragment set:html={html} />
				</div>
			</div>
		</div>
	) : (
		<Content />
	)}
</Base>