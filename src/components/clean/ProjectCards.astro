---
import type { CollectionEntry } from "astro:content";
import { imageSize } from "../../lib/image-size.mjs";

interface Props {
	items: CollectionEntry<"caseStudies">[];
}

const [feature, ...rest] = Astro.props.items;

const card = (entry: CollectionEntry<"caseStudies">) => {
	const src = entry.data.cardImage ?? entry.data.cover;
	return { slug: entry.id, title: entry.data.title, text: entry.data.subheading ?? entry.data.description, src, size: src ? imageSize(src) : undefined, alt: `${entry.data.client ?? entry.data.title} project` };
};
const cards = [feature, ...rest].filter(Boolean).map(card);
---

<article class="clean-project clean-project--feature">
	<a class="clean-project__media" href={`/case-studies/${cards[0].slug}/`}><img src={cards[0].src} alt={cards[0].alt} loading="lazy" {...cards[0].size} /></a>
	<h3 class="clean-project__title"><a class="clean-link" href={`/case-studies/${cards[0].slug}/`}>{cards[0].title}</a></h3>
	<p><a class="clean-link" href={`/case-studies/${cards[0].slug}/`}>{cards[0].text}</a></p>
</article>
{cards.length > 1 && (
	<div class="clean-project-grid">
		{cards.slice(1).map((c) => (
			<article class="clean-project">
				<a class="clean-project__media" href={`/case-studies/${c.slug}/`}><img src={c.src} alt={c.alt} loading="lazy" {...c.size} /></a>
				<h3 class="clean-project__title"><a class="clean-link" href={`/case-studies/${c.slug}/`}>{c.title}</a></h3>
				<p><a class="clean-link" href={`/case-studies/${c.slug}/`}>{c.text}</a></p>
			</article>
		))}
	</div>
)}
