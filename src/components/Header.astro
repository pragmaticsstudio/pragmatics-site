---
const links = [
	["Home", `${import.meta.env.BASE_URL}/`],
	["Services", `${import.meta.env.BASE_URL}/services/`],
	["Projects", `${import.meta.env.BASE_URL}/case-studies/`],
	["Blog", `${import.meta.env.BASE_URL}/blog/`],
	["About", `${import.meta.env.BASE_URL}/studio/`],
];
---

<header class="header">
	<div class="navbar-wrapper">
		<div class="navbar">
			<div class="page-padding">
				<div class="container-xxlarge">
					<div class="navbar-inner">
						<a href={`${import.meta.env.BASE_URL}/`} class="animation-link w-nav-brand" aria-label="Pragmatics home">
							<span class="nav-text">Pragmatics</span>
						</a>
						<nav class="nav-menu" aria-label="Main navigation">
							{links.map(([label, href]) => <a href={href} class="navbar-menu-item-link"><span class="nav-text">{label}</span></a>)}
							<a href={`${import.meta.env.BASE_URL}/contact/`} class="navbar-menu-item-link"><span class="nav-text">Contact</span></a>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>