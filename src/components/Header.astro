---
const links = [
	["Home", `${import.meta.env.BASE_URL}/`],
	["Services", `${import.meta.env.BASE_URL}/services/`],
	["Projects", `${import.meta.env.BASE_URL}/case-studies/`],
	["Blog", `${import.meta.env.BASE_URL}/blog/`],
	["About", `${import.meta.env.BASE_URL}/studio/`],
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a href={`${import.meta.env.BASE_URL}/`} class="site-logo" aria-label="Pragmatics home">Pragmatics</a>
		<nav class="site-nav" aria-label="Main navigation">
			{links.map(([label, href]) => (
				<a href={href} class="site-nav__link">{label}</a>
			))}
		</nav>
	</div>
</header>