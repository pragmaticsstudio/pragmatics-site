---
// import.meta.env.BASE_URL already ends with a trailing slash (e.g. "/"),
// so link paths must not start with one, otherwise the concatenated href
// becomes a protocol-relative URL like "//services/" that browsers treat
// as pointing to a different host instead of a local path.
const links = [
	["Home", ""],
	["Services", "services/"],
	["Projects", "case-studies/"],
	["Blog", "blog/"],
	["About", "studio/"],
];
---

<header class="header">
	<div class="navbar-wrapper">
		<div class="navbar">
			<div class="page-padding">
				<div class="container-xxlarge">
					<div class="navbar-inner">
						<a href={import.meta.env.BASE_URL} class="animation-link w-nav-brand" aria-label="Pragmatics home">
							<span class="nav-text">Pragmatics</span>
						</a>
						<nav class="nav-menu" aria-label="Main navigation">
							{links.map(([label, href]) => <a href={`${import.meta.env.BASE_URL}${href}`} class="navbar-menu-item-link"><span class="nav-text">{label}</span></a>)}
						</nav>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	@media screen and (max-width: 767px) {
		.navbar-inner {
			flex-wrap: wrap;
			row-gap: 1rem;
		}

		.nav-menu {
			flex-wrap: wrap;
			row-gap: 0.5rem;
			justify-content: flex-start;
			width: 100%;
		}
	}
</style>