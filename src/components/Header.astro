---
// import.meta.env.BASE_URL already ends with a trailing slash (e.g. "/"),
// so link paths must not start with one, otherwise the concatenated href
// becomes a protocol-relative URL like "//services/".
const base = import.meta.env.BASE_URL;
const links = [
	["Home", ""],
	["Services", "services/"],
	["Projects", "case-studies/"],
	["Blog", "blog/"],
	["About", "studio/"],
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a href={base} class="site-logo" aria-label="Pragmatics home"><img src="/logo-mark.svg" alt="" width="566" height="237" /><span>pragmatics</span></a>
		<nav class="site-nav" aria-label="Main navigation">
			{links.map(([label, href]) => (
				<a href={`${base}${href}`} class="site-nav__link">{label}</a>
			))}
		</nav>
	</div>
</header>
