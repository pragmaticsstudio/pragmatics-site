---
const year = new Date().getFullYear();

const socialLinks = [
	{ label: "YouTube", href: "https://www.youtube.com/@pragmaticsstudio" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/company/pragmatics-studio" },
];
---

<footer class="footer">
	<div class="page-padding">
		<div class="container-xxlarge">
			<div class="footer-inner">
				<p class="footer-copyright">&copy; {year} Pragmatics Studio. All rights reserved.</p>
				<ul class="footer-social">
					{socialLinks.map(({ label, href }) => (
						<li>
							<a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 2rem 0;
	}

	.footer-copyright {
		margin: 0;
		font-size: 0.875rem;
	}

	.footer-social {
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
	}

	.footer-social a {
		color: inherit;
		text-decoration: none;
	}

	.footer-social a:hover,
	.footer-social a:focus {
		text-decoration: underline;
	}

	@media screen and (max-width: 479px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
